{{/*
# Generated by quoll — https://github.com/theo-mrn/Quoll
# Do not edit by hand: change quoll.toml, then run `quoll k8s update`.
*/}}

{{- define "app.labels" -}}
{{ include "app.selectorLabels" . }}
app.kubernetes.io/version: {{ .Chart.AppVersion | quote }}
app.kubernetes.io/managed-by: {{ .Release.Service }}
helm.sh/chart: {{ printf "%s-%s" .Chart.Name .Chart.Version }}
{{- end }}

{{- define "app.selectorLabels" -}}
app.kubernetes.io/name: {{ .Chart.Name }}
app.kubernetes.io/instance: {{ .Release.Name }}
{{- end }}

{{/* The image by digest when the deployment gives one (what was scanned and signed), else by tag. */}}
{{- define "app.image" -}}
{{- $repository := required "image.repository is required" .Values.image.repository -}}
{{- if .Values.image.digest -}}
{{ $repository }}@{{ .Values.image.digest }}
{{- else -}}
{{ $repository }}:{{ .Values.image.tag }}
{{- end -}}
{{- end }}

{{/* HTTP on healthPath when the app has one, a TCP connection to its port otherwise. */}}
{{- define "app.probe" -}}
{{- if .Values.healthPath -}}
httpGet:
  path: {{ .Values.healthPath }}
  port: http
{{- else -}}
tcpSocket:
  port: http
{{- end -}}
{{- end }}
