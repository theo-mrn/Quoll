{% block build %}
FROM golang:{{ go_tag }} AS build
WORKDIR /src
# Dependencies first: code changes don't download them again.
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=bind,source=go.mod,target=go.mod \
{% if go_sum %}
    --mount=type=bind,source=go.sum,target=go.sum \
{% endif %}
    go mod download
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 {{ cfg.build_command }}
{% endblock %}

{% block runtime %}
# Static binary on distroless: no shell, no package manager, non-root.
FROM gcr.io/distroless/static-debian13:nonroot
COPY --from=build /out/app /app
# distroless' nonroot, numeric: Kubernetes can then check it isn't root (runAsNonRoot).
USER 65532:65532
EXPOSE {{ cfg.port }}
CMD {{ cfg.command | exec_form }}
{% endblock %}
