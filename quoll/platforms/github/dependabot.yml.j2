version: 2
updates:
{% for ecosystem, directory in ecosystems %}
  - package-ecosystem: "{{ ecosystem }}"
    directory: "{{ directory }}"
    schedule:
      interval: "weekly"
    # A new release waits a week: compromised versions are usually pulled by then.
    cooldown:
      default-days: 7
    open-pull-requests-limit: 5
    groups:
      minor-and-patch:
        update-types: ["minor", "patch"]
{% if ecosystem == "npm" %}
    ignore:
      # Node's types follow the runtime's major (.nvmrc), not the latest one.
      - dependency-name: "@types/node"
        update-types: ["version-update:semver-major"]
{% endif %}

{% endfor %}
{% for directory in docker %}
  - package-ecosystem: "docker"
    directory: "{{ directory }}"
    schedule:
      interval: "weekly"
    # A new release waits a week: compromised versions are usually pulled by then.
    cooldown:
      default-days: 7
    groups:
      base-images:
        patterns: ["*"]
    ignore:
      # The runtime's major is quoll.toml's ([docker] version): change it there, then `quoll docker update`.
      - dependency-name: "*"
        update-types: ["version-update:semver-major"]

{% endfor %}
  - package-ecosystem: "github-actions"
    directory: "/"
    schedule:
      interval: "weekly"
    # A new release waits a week: compromised versions are usually pulled by then.
    cooldown:
      default-days: 7
    groups:
      actions:
        patterns: ["*"]
